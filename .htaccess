Options -MultiViews

# Custom error docs (paths from docroot)
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php

RewriteEngine On

# Serve real files/dirs
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Never rewrite the errors folder
RewriteRule ^errors/ - [L]
RewriteRule ^(index|contact|registration|login|search|logout|profile|users_search|about|privacy|forgot)$ $1.php [NC,L]

# Only rewrite if not a real file or directory
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# --- ROOT-LEVEL POST SLUGS ---
# Example: /asus-rog-zephyrus-g14-review-a-powerful-and-portable-gaming-laptop-for-gamers-on-the-go-481
RewriteRule ^([A-Za-z0-9-]+)-([0-9]+)/?$ post.php?p_id=$2 [NC,L,QSA]

# Post actions (still need ID)
RewriteRule ^([0-9]+)/edit/([0-9]+)/?$ post.php?p_id=$1&edit=$2 [NC,L,QSA]
RewriteRule ^([0-9]+)/delete/([0-9]+)/?$ post.php?p_id=$1&delete_comment=$2 [NC,L,QSA]
RewriteRule ^([0-9]+)/like/([0-9]+)/?$ post.php?p_id=$1&like=$2 [NC,L,QSA]
RewriteRule ^([0-9]+)/unlike/([0-9]+)/?$ post.php?p_id=$1&unlike=$2 [NC,L,QSA]

# --- CATEGORY ROUTE ---
RewriteRule ^category/([^/]+)/([0-9]+)/?$ category.php?category=$1&cat_id=$2 [NC,L,QSA]


