RewriteEngine on

RewriteRule ^(index|contact|registration|login|search|logout|profile|users_search|about)$ $1.php [NC,L]

RewriteRule ^post/(\d+)$ post.php?p_id=$1 [NC,L]

RewriteRule ^post/(\d+)/edit/(\d+)$ post.php?p_id=$1&edit=$2 [NC,L]

RewriteRule ^post/(\d+)/delete/(\d+)$ post.php?p_id=$1&delete_comment=$2 [NC,L]

RewriteRule ^post/(\d+)/like/(\d+)$ post.php?p_id=$1&like=$2 [NC,L]

RewriteRule ^post/(\d+)/unlike/(\d+)$ post.php?p_id=$1&unlike=$2 [NC,L]

RewriteRule ^category/([^/]*)/(\d+)/?$ category.php?category=$1&cat_id=$2 

# RewriteRule ^forgot/([^/]*)$ forgot.php?forgot=$1 

ErrorDocument 500 /errors/500.php
ErrorDocument 404 /errors/404.php




# Protect the .htaccess file from unauthorized access
<Files .htaccess>
    Order Allow,Deny
    Deny from all
</Files>

# Protect the custom config file (settings-core-7189.php)
<Files settings-core-7189.php>
    Order Deny,Allow
    Deny from all
</Files>

# Disable Directory Listing (prevents users from browsing directories)
Options -Indexes

# Block PHP execution in sensitive directories like /classes
<Directory "/classes">
    <Files "*.php">
        deny from all
    </Files>
</Directory>

<Directory "/includes">
    <Files "*.php">
        deny from all
    </Files>
</Directory>

# Disable XML-RPC (if not needed)
<Files xmlrpc.php>
    Order Deny,Allow
    Deny from all
</Files>

# Block Bad Bots (you can expand the list of user agents as needed)
SetEnvIf User-Agent "BadBot" bad_bot
Deny from env=bad_bot

# Prevent Hotlinking (replace with your actual domain)
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^http(s)?://(www\.)?mediumslateblue-ape-414091.hostingersite.com [NC]
RewriteRule \.(jpg|jpeg|png|gif|bmp|swf|flv)$ - [F]

# Force HTTPS (ensure SSL is set up correctly)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Disable HTTP methods other than GET and POST
<LimitExcept GET POST>
    Order Deny,Allow
    Deny from all
</LimitExcept>

# Hide server version details for security
ServerSignature Off

# Limit access to sensitive files (can be added for other sensitive files)
<FilesMatch "(^\.|settings-core-7189\.php)">
    Order Deny,Allow
    Deny from all
</FilesMatch>
